requires 1.4.0
# Generated by app/ssf.py — do not hand-edit (regenerate via /stack/render).
# Multi-night final step: merge every night's already-calibrated pp_light
# sequence (each built by its own calibrate_night.ssf.j2 step/process),
# then register + stack the merged sequence. This is the only step where
# `register` runs on more than one night's worth of frames at once, so
# it's also the only stack step still exposed to gotcha #8-style cost —
# unavoidable, since merge/register/stack all need every night's data in
# one place; per-night calibrate is what gotcha #8 actually made expensive.
cd "{{ merge_dir }}"
merge {% for p in pp_light_dirs %}"{{ p }}/pp_light"{{ " " if not loop.last else "" }}{% endfor %} all_lights
register all_lights -layer=0
stack r_all_lights {{ stack_cmd }} -norm=addscale -output_norm -out=result
close
