requires 1.4.0
# Generated by app/ssf.py — do not hand-edit (regenerate via /stack/render).
# NOTE: `cd "path"` strips quotes correctly, but `-key="path"` style options
# (e.g. -out=/-dark=/-flat=) do NOT — the quotes become literal characters
# in the path. Confirmed empirically; keep those unquoted even though `cd`
# and merge's bare positional paths stay quoted.

{% for night in nights %}
# ---- Lights: {{ night.key }} ({{ night.raw_lights }}) ----
cd "{{ night.raw_lights }}"
convert light -out={{ night.process_dir }}
cd "{{ night.process_dir }}"
calibrate light -dark={{ dark_master }} -flat={{ night.flat_master }}{{ cc_flag }}{{ osc_flags }}
{% endfor %}
# ---- Registration & stack ----
{% if merge %}
cd "{{ base_process_dir }}"
merge {% for night in nights %}"{{ night.process_dir }}/pp_light"{{ " " if not loop.last else "" }}{% endfor %} all_lights
register all_lights -layer=0
stack r_all_lights {{ stack_cmd }} -norm=addscale -output_norm -out=result
{% else %}
cd "{{ base_process_dir }}"
register pp_light
stack r_pp_light {{ stack_cmd }} -norm=addscale -output_norm -out=result
{% endif %}
close
