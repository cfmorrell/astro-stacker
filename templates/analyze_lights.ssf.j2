requires 1.4.0
# Generated by app/ssf.py — do not hand-edit (regenerate via /lights/analyze/render).
# Calibrates + registers each night's lights INDEPENDENTLY (no stacking, no
# merge) purely to harvest per-frame FWHM/roundness/background/star-count
# from Siril's own registration data — parsed from the resulting .seq file
# by app/seqstats.py — for human review. Nothing here excludes any frame;
# see Handoff.md's frame-review notes (astropup-blink-style: recommend,
# don't auto-filter).

{% for night in nights %}
# ---- Night: {{ night.key }} ({{ night.raw_lights }}) ----
cd "{{ night.raw_lights }}"
convert light -out={{ night.process_dir }}
cd "{{ night.process_dir }}"
calibrate light -dark={{ dark_master }} -flat={{ night.flat_master }}{{ cc_flag }}{{ osc_flags }}
register pp_light
{% endfor %}
close
