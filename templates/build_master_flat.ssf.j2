requires 1.4.0
# Generated by app/ssf.py — do not hand-edit (regenerate via /masters/render).
# Runs as its own siril-cli process, one per night (Handoff.md gotcha #8),
# into a disposable scratch dir; app/main.py moves master_flat.fit to its
# stable per-night location afterward (Handoff.md gotcha #6). `bias_arg`
# is the shared master bias's STABLE path (process/master_bias) — the
# bias step (and its move) always runs and completes before any flat
# step starts, so this file already exists there by the time this runs.
cd "{{ raw_dir }}"
convert flat -out={{ process_dir }}
cd "{{ process_dir }}"
{% if bias_arg %}
calibrate flat -bias={{ bias_arg }}
{% else %}
calibrate flat
{% endif %}
stack pp_flat {{ stack_cmd }} -norm=mul -out=master_flat
close
