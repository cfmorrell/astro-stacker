requires 1.4.0
# Generated by app/ssf.py — do not hand-edit (regenerate via /masters/render).
# NOTE: `cd "path"` strips quotes correctly, but `-key="path"` style options
# (e.g. -out=) do NOT — the quotes become literal characters in the path.
# Confirmed empirically; keep those unquoted even though `cd` stays quoted.

{% if build_bias %}
# ---- Master bias (shared across all nights) ----
cd "{{ raw_biases }}"
convert bias -out={{ process_dir }}
cd "{{ process_dir }}"
stack bias {{ stack_cmd }} -nonorm -out=master_bias
{% endif %}
{% if build_dark %}
# ---- Master dark (shared across all nights) ----
cd "{{ raw_darks }}"
convert dark -out={{ process_dir }}
cd "{{ process_dir }}"
stack dark {{ stack_cmd }} -nonorm -out=master_dark
{% endif %}
{% for flat in flat_targets %}
# ---- Master flat: {{ flat.label }} ----
cd "{{ flat.raw_flats }}"
convert flat -out={{ flat.process_dir }}
cd "{{ flat.process_dir }}"
{% if flat.bias_arg %}
calibrate flat -bias={{ flat.bias_arg }}
{% else %}
calibrate flat
{% endif %}
stack pp_flat {{ stack_cmd }} -norm=mul -out=master_flat
{% endfor %}
close
