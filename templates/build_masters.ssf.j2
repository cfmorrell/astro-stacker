requires 1.4.0
# Generated by app/ssf.py — do not hand-edit (regenerate via /masters/render).
# NOTE: `cd "path"` strips quotes correctly, but `-key="path"` style options
# (e.g. -out=) do NOT — the quotes become literal characters in the path,
# silently creating a dir named `"...path"`. Confirmed empirically; keep
# -out=/-dark=/-flat=/etc. unquoted here even though `cd` stays quoted.

{% if build_bias %}
# ---- Master bias ----
cd "{{ raw_biases }}"
convert bias -out={{ process_dir }}
cd "{{ process_dir }}"
stack bias {{ stack_cmd }} -nonorm -out=master_bias
{% endif %}
{% if build_dark %}
# ---- Master dark ----
cd "{{ raw_darks }}"
convert dark -out={{ process_dir }}
cd "{{ process_dir }}"
stack dark {{ stack_cmd }} -nonorm -out=master_dark
{% endif %}
{% if build_flat %}
# ---- Master flat ----
cd "{{ raw_flats }}"
convert flat -out={{ process_dir }}
cd "{{ process_dir }}"
{% if bias_arg %}
calibrate flat -bias={{ bias_arg }}
{% else %}
calibrate flat
{% endif %}
stack pp_flat {{ stack_cmd }} -norm=mul -out=master_flat
{% endif %}
close
