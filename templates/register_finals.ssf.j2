requires 1.4.0
# Generated by app/ssf.py — do not hand-edit (regenerate via
# /register-finals/render). Final step for a multi-filter (or multi-
# exposure-group) project: registers N already-stacked single results
# against EACH OTHER as a tiny N-frame "sequence", so they land pixel-
# aligned for combining as channels in external post-processing (e.g.
# PixInsight) without a separate manual alignment pass there. Unlike
# stack_*.ssf.j2's own `register` calls, there is no `stack` line after
# this - `register` alone already writes one aligned r_final_NNNNN.fit
# per input frame, which is exactly N outputs, not one merged image
# (see app/ssf.py's render_register_finals()/apply_register_finals_input()
# for how the N inputs get symlinked into input_dir, in a known
# alphabetical order, before this runs).
cd "{{ input_dir }}"
convert final -out={{ scratch_dir }}
cd "{{ scratch_dir }}"
register final
close
