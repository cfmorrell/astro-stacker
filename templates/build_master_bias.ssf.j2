requires 1.4.0
# Generated by app/ssf.py — do not hand-edit (regenerate via /masters/render).
# Runs as its own siril-cli process (Handoff.md gotcha #8) into a
# disposable scratch dir; app/main.py moves master_bias.fit to its stable
# location afterward (Handoff.md gotcha #6 — this dir is wiped fresh
# every run, so a subsequent build never sees a stale prior run's files).
cd "{{ raw_dir }}"
convert bias -out={{ process_dir }}
cd "{{ process_dir }}"
stack bias {{ stack_cmd }} -nonorm -out=master_bias
close
