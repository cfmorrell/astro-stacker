# syntax=docker/dockerfile:1
#
# Dev image: Python + Siril CLI + FastAPI (app/).
# CMD runs `uvicorn --reload` directly (see bottom of this file) so the
# container is a self-starting, always-on dev server once built — no manual
# `docker exec` step needed to bring the app up. /app is bind-mounted over
# the code baked in at build time, so edits made on the host take effect
# immediately via --reload.
#
# Build + run: see run-dev.sh at the repo root (also handles rebuild/restart
# on UnRAID). It publishes -p 8083:8000 with --restart unless-stopped, which
# NPM proxies at astro-stacker-dev.cfmorrell.com (see docs/DEPLOY.md) — reach
# it directly, no SSH tunnel needed.
#
# For a shell alongside the running server (ad hoc `pip install`s persist in
# this long-lived container until it's rebuilt):
#   docker exec -it astro-stacker-dev bash
# (the `astro-stacker` SSH alias does this automatically)

FROM debian:bookworm-slim

RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
        curl unzip ca-certificates squashfs-tools binutils \
        python3 python3-pip python3-venv git \
        libgsl27 libfftw3-double3 libfftw3-single3 libgomp1 libexiv2-27 \
        libheif1 libraw20 libwcs7 libglib2.0-0 libgl1 libxrender1 libxext6 \
        libxft2 libfontconfig1 libsm6 libcurl4 libcfitsio10 libopencv-core406 \
        vim nano\
    && rm -rf /var/lib/apt/lists/*

# --- Siril 1.4 AppImage, extracted without FUSE ------------------------------
# Same trick astrolab's own Dockerfile uses: unsquashfs the AppImage's
# embedded squashfs directly instead of running the ELF stub, which avoids
# needing FUSE inside the container entirely.
ARG SIRIL_VERSION=1.4.3
ARG SIRIL_URL=https://free-astro.org/download/Siril-1.4.3-x86_64.AppImage

WORKDIR /fetch
RUN curl -fL --progress-bar -o Siril.AppImage "$SIRIL_URL" && \
    printf '%s\n' \
      'import struct' \
      'f = open("Siril.AppImage","rb")' \
      'f.seek(40); shoff = struct.unpack("<Q", f.read(8))[0]' \
      'f.seek(58); shentsize, shnum = struct.unpack("<HH", f.read(4))' \
      'print(shoff + shentsize * shnum)' \
      > offset.py && \
    OFFSET=$(python3 offset.py) && \
    echo "squashfs offset: $OFFSET bytes" && \
    unsquashfs -offset "$OFFSET" -d /opt/siril Siril.AppImage && \
    rm -rf /fetch

# AppRun is the AppImage's own launcher/dispatcher; it works for both the
# GUI and CLI entry points. If invoking it directly ever misbehaves, look
# for the CLI binary explicitly at /opt/siril/usr/bin/siril-cli instead.
ENV SIRIL_BIN=/opt/siril/AppRun \
    PATH="/opt/siril/usr/bin:${PATH}" \
    PYTHONUNBUFFERED=1

WORKDIR /app

# FastAPI web layer (see app/). Copied+installed at build time so a fresh
# container has it; since /app is bind-mounted over this at runtime anyway,
# `pip install -r requirements.txt` after editing it also works live via
# `docker exec` without a rebuild — ad hoc installs persist in this
# long-lived container between sessions (see run instructions above).
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --break-system-packages --no-cache-dir -r /tmp/requirements.txt

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
